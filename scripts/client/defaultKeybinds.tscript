if(!isObject( ExampleWheeledMove ) )
{
   new ActionMap(ExampleWheeledMove)
   {
      humanReadableName = "Example Wheeled Vehicle Move";
   };
}

//------------------------------------------------------------------------------
// Set up remappable entries
//------------------------------------------------------------------------------
addKeyRemap("Forward", "ExampleWheeledMove", "keyboard", "moveForward", "Forward Movement");
addKeyRemap("Backward", "ExampleWheeledMove", "keyboard", "movebackward", "Backward Movement");
addKeyRemap("Strafe Left", "ExampleWheeledMove", "keyboard", "moveleft", "Left Strafing Movement");
addKeyRemap("Strafe Right", "ExampleWheeledMove", "keyboard", "moveright", "Right Strafing Movement");
addKeyRemap("Ascend", "ExampleWheeledMove", "keyboard", "moveup", "Makes the camera ascend");
addKeyRemap("Descend", "ExampleWheeledMove", "keyboard", "movedown", "Makes the camera descend");
addKeyRemap("Jump", "ExampleWheeledMove", "keyboard", "jump", "Jump");

//addKeyRemap("Forward", "ExampleWheeledMove", "gamepad", "gamePadMoveY", "Forward Movement");
//addKeyRemap("Backward", "ExampleWheeledMove", "gamepad", "gamePadMoveY", "Backward Movement");
//addKeyRemap("Strafe Left", "ExampleWheeledMove", "gamepad", "gamePadMoveX", "Left Strafing Movement");
//addKeyRemap("Strafe Right", "ExampleWheeledMove", "gamepad", "gamePadMoveX", "Right Strafing Movement");
addKeyRemap("Jump", "ExampleWheeledMove", "gamepad", "jump", "Jump");

//------------------------------------------------------------------------------
// Non-remapable binds
//------------------------------------------------------------------------------
ExampleWheeledMove.bind( keyboard, F2, showPlayerList );
ExampleWheeledMove.bind(keyboard, "ctrl h", hideHUDs);
ExampleWheeledMove.bind(keyboard, "alt p", doScreenShotHudless);

//------------------------------------------------------------------------------
// Movement Keys
//------------------------------------------------------------------------------
ExampleWheeledMove.bind( keyboard, a, moveleft );
ExampleWheeledMove.bind( keyboard, d, moveright );
ExampleWheeledMove.bind( keyboard, left, moveleft );
ExampleWheeledMove.bind( keyboard, right, moveright );

ExampleWheeledMove.bind( keyboard, w, moveforward );
ExampleWheeledMove.bind( keyboard, s, movebackward );
ExampleWheeledMove.bind( keyboard, up, moveforward );
ExampleWheeledMove.bind( keyboard, down, movebackward );

if(isObject(FPSPlayer))
{
   //Ignore this command if the FPS player module is not here.
   ExampleWheeledMove.bind(keyboard, f, getout);
}

ExampleWheeledMove.bind( keyboard, e, moveup );
ExampleWheeledMove.bind( keyboard, c, movedown );

ExampleWheeledMove.bind( keyboard, space, jump );
ExampleWheeledMove.bind( mouse, xaxis, yaw );
ExampleWheeledMove.bind( mouse, yaxis, pitch );

ExampleWheeledMove.bind( gamepad, thumbrx, "D", "-0.23 0.23", gamepadYaw );
ExampleWheeledMove.bind( gamepad, thumbry, "D", "-0.23 0.23", gamepadPitch );
ExampleWheeledMove.bind( gamepad, thumblx, "D", "-0.23 0.23", gamePadMoveX );
ExampleWheeledMove.bind( gamepad, thumbly, "D", "-0.23 0.23", gamePadMoveY );

ExampleWheeledMove.bind( gamepad, btn_a, jump );
ExampleWheeledMove.bindCmd( gamepad, btn_back, "disconnect();", "" );
ExampleWheeledMove.bind( keyboard, tab, toggleFirstPerson );

ExampleWheeledMove.bind( keyboard, Escape, escapeFromGame);
//------------------------------------------------------------------------------
// Demo recording functions
//------------------------------------------------------------------------------
ExampleWheeledMove.bind( keyboard, F3, startRecordingDemo );
ExampleWheeledMove.bind( keyboard, F4, stopRecordingDemo );

//------------------------------------------------------------------------------
// Helper Functions
//------------------------------------------------------------------------------
GlobalActionMap.bind(keyboard, "ctrl F3", doProfile);

//------------------------------------------------------------------------------
// Misc.
//------------------------------------------------------------------------------
GlobalActionMap.bind(keyboard, "tilde", toggleConsole);
ExampleWheeledMove.bindCmd(keyboard, "n", "toggleNetGraph();", "");