function RatRodExample::onCreate(%this)
{
}

function RatRodExample::onDestroy(%this)
{
}

//This is called when the server is initially set up by the game application
function RatRodExample::initServer(%this)
{
   %this.queueExec("./scripts/server/server");
}

//This is called when the server is created for an actual game/map to be played
function RatRodExample::onCreateGameServer(%this)
{
   %this.registerDatablock("./datablocks/vehicles/RatRodDB");
}

//This is called when the server is shut down due to the game/map being exited
function RatRodExample::onDestroyGameServer(%this)
{
}

//This is called when the client is initially set up by the game application
function RatRodExample::initClient(%this)
{
   %this.queueExec("./scripts/client/inputCommands");
   %this.queueExec("./scripts/client/client");

   //client scripts
   exec("./scripts/client/defaultkeybinds");
   
   %prefPath = getPrefpath();
   if(isScriptFile(%prefPath @ "/keybinds"))
      exec(%prefPath @ "/keybinds");
   %this.queueExec("./scripts/client/clientRatRod");
}

//This is called when a client connects to a server
function RatRodExample::onCreateClientConnection(%this)
{
}

//This is called when a client disconnects from a server
function RatRodExample::onDestroyClientConnection(%this)
{
}
