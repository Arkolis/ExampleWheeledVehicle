singleton TSShapeConstructor(RatRodDAE)
{
   baseShapeAsset = "ExampleWheeledVehicle:RatRod_Shape";
   lodType = "TrailingNumber";
   neverImport = "null	EnvironmentAmbientLight";
   matNamePrefix = "";
   forceUpdateMaterials = "0";
   loadLights = "0";
};

function RatRodDAE::onLoad(%this)
{
   %this.setSequenceCyclic("ambient", "0");
   %this.addSequence("ambient", "steering", "1", "3", "1", "0");
   %this.addSequence("ambient", "spring0", "10", "11", "1", "0");
   %this.addSequence("ambient", "spring1", "20", "21", "1", "0");
   %this.addSequence("ambient", "spring2", "30", "31", "1", "0");
   %this.addSequence("ambient", "spring3", "40", "41", "1", "0");
   echo("RatRodDAE Loaded...");
}
